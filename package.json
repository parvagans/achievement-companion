{
  "name": "steam-deck-achievement-companion",
  "private": true,
  "version": "0.3.3",
  "author": "Adam <nullbit5@protonmail.com>",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "node scripts/clean_decky_dist.mjs && node scripts/sync_decky_notices.mjs && rollup -c",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:release": "python scripts/package_release.py",
    "check:release": "python scripts/check_release_artifact.py",
    "test": "node --import tsx --test tests/createAppServices.test.ts tests/app-runtime.test.ts tests/app-runtime-nondecky.test.ts tests/decky-recent-achievement-history-selection.test.ts && python -m unittest discover -s tests/python -p \"test_*.py\""
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "4.11.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^5.3.4"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router": "5.1.20",
    "rollup": "^4.53.3",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.4.0"
}
