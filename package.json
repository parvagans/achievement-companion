{
  "name": "steam-deck-achievement-companion",
  "private": true,
  "version": "0.19.3",
  "author": "parvagans",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "version:sync": "node scripts/version/sync-version.mjs",
    "version:check": "node scripts/version/check-version.mjs",
    "build": "node scripts/version/check-version.mjs --allow-decky-package-suffix && node scripts/clean_decky_dist.mjs && node scripts/sync_decky_notices.mjs && rollup -c",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:release": "node scripts/version/check-version.mjs && python scripts/package_release.py",
    "check:release": "python scripts/check_release_artifact.py",
    "release:prepare": "node scripts/prepare-release.mjs",
    "update:test:prepare": "node scripts/update/prepare-local-update.mjs",
    "update:test:serve": "node scripts/update/serve-local-update.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:node": "node scripts/run-tests.mjs --node-only",
    "test:python": "node scripts/run-tests.mjs --python-only"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "4.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^5.3.4",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router": "5.1.20",
    "@types/semver": "^7.7.1",
    "rollup": "^4.53.3",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.4.0"
}
